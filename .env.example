# Buddy AI Assistant — Environment Configuration
# Copy this to .env and fill in your values.
# Do NOT commit .env to version control.

# ── Frontend ──────────────────────────────────────────────────────────────────
# Backend API base URL
VITE_API_URL=http://localhost:5000/api

# ── Backend ───────────────────────────────────────────────────────────────────
# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change_me_in_production

# ── ADB Phone Connection ──────────────────────────────────────────────────────
# Your phone's Tailscale IP (run: tailscale ip -4 on the phone)
BUDDY_PHONE_IP=100.x.x.x
BUDDY_PHONE_PORT=5555

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Debug mode (set to false in production)
FLASK_DEBUG=false
